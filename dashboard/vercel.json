{
  "framework": "nextjs",
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/inbound-draft-catchup",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/gmail-watch",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/email/ingest?window=1440",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/catchup-summaries",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/sales-enrich",
      "schedule": "30 0 * * *"
    }
  ]
}
