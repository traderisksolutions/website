# Copy to .env for local runs. On Cloud Run these come from env vars and Secret Manager.
SUPABASE_URL=https://trs-api-335840130686.asia-southeast1.run.app
SUPABASE_SERVICE_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=            # fallback writer
OPENAI_API_KEY=            # optional: document embeddings + last-resort fallback
CONTENT_ENGINE_SECRET=     # shared with the dashboard (CONTENT_ENGINE_SECRET there too)
ENGINE_MODEL_STRONG=claude-opus-5-5
ENGINE_MODEL_FAST=claude-sonnet-5-5
ENGINE_PROVIDER_ORDER=anthropic,gemini,openai
ENGINE_POLL_SECONDS=15
ENGINE_DEFAULT_SITE_ID=    # CLI only: the site `generate` targets when --site-id is omitted
