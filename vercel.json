{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "x-vercel-skip-toolbar",
          "value": "1"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|svg|ico|gif)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/styles/(.*)\\.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/scripts/(.*)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/api",
      "destination": "/api.html"
    },
    {
      "source": "/api/",
      "destination": "/api.html"
    }
  ],
  "redirects": [
    {
      "source": "/pricing",
      "destination": "/working-with-trs/",
      "permanent": true
    },
    {
      "source": "/pricing.html",
      "destination": "/working-with-trs/",
      "permanent": true
    },
    {
      "source": "/commercial/financial-assets",
      "destination": "/commercial/trade-credit/",
      "permanent": true
    },
    {
      "source": "/commercial/financial-assets/",
      "destination": "/commercial/trade-credit/",
      "permanent": true
    },
    {
      "source": "/commercial/inventory",
      "destination": "/commercial/marine-cargo/",
      "permanent": true
    },
    {
      "source": "/commercial/inventory/",
      "destination": "/commercial/marine-cargo/",
      "permanent": true
    },
    {
      "source": "/solutions",
      "destination": "/business/",
      "permanent": true
    },
    {
      "source": "/solutions.html",
      "destination": "/business/",
      "permanent": true
    },
    {
      "source": "/about.html",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/:group(commercial|employees|personal|consumers|solutions)/:slug",
      "destination": "/:group/:slug/",
      "permanent": true
    },
    {
      "source": "/claims",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/claims.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/api/(white-label|gig-worker|rentals)",
      "destination": "/api",
      "permanent": true
    },
    {
      "source": "/api/(white-label|gig-worker|rentals)/",
      "destination": "/api",
      "permanent": true
    },
    {
      "source": "/(dashboard|roadplus|supabase|tools|ai-inbound|benefixe|newsouthsea|corpcover)/(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/(.*)\\.(py|sql|ts|tsx|md)",
      "destination": "/",
      "permanent": false
    }
  ]
}
